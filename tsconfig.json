{
  "compilerOptions": {
    "jsx": "react-jsx",                   // React JSX 변환 방식 설정
    "types": ["react", "jest", "node"],                   // React 타입만 포함
    "baseUrl": "./src",                   // 절대 경로의 기본 경로 설정
    "paths": {
      "@/*": ["*"]                        // @를 src로 매핑하여 절대경로 사용
    },
    "strict": true,                       // 모든 엄격한 타입 검사 활성화
    "noImplicitAny": true,                // 암시적 any 금지
    "strictNullChecks": true,             // null/undefined 체크 필수
    "strictFunctionTypes": true,          // 함수 타입 호환성 엄격화
    "noImplicitThis": true,               // this의 암시적 any 금지
    "alwaysStrict": true,                 // 모든 파일에서 'use strict'
    "forceConsistentCasingInFileNames": true, // 대소문자 불일치 경로 오류 방지
    "noUnusedLocals": true,               // 사용되지 않는 변수 금지
    "noUnusedParameters": true,           // 사용되지 않는 매개변수 금지
    "noImplicitReturns": true,            // return 누락 금지
    "noFallthroughCasesInSwitch": true,  // switch fallthrough 금지
    "esModuleInterop": true,              // CommonJS 모듈 호환
    "skipLibCheck": true,                 // 라이브러리 파일 검사 건너뛰기 (성능 향상)
    "resolveJsonModule": true,            // JSON 파일 import 허용
    "moduleResolution": "node",           // 모듈 해석 방식 지정 (Node.js 방식)
    "lib": ["DOM", "ES2020", "ESNext"],  // 사용할 라이브러리 추가
    "target": "ESNext",                   // JavaScript의 목표 버전 설정
    "module": "ESNext",                   // 모듈 시스템 설정
    "allowJs": true,                      // JavaScript 파일을 TypeScript 프로젝트에서 사용 가능하게 허용
    "isolatedModules": true               // 각 파일을 독립적으로 모듈화하여 처리
  },
  "include": [
    "src"  // src 디렉토리 포함
  ],
  "exclude": [
    "node_modules",  // node_modules 제외
    "build"          // build 디렉토리 제외
  ]
}
